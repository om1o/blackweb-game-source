; BLACKWEB house-opening rebuild. Godot 4, Compatibility renderer.
config_version=5

[application]
config/name="Arachnophobia: Blackweb"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="BlackwebHouseRebuild"

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.023, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
